# Santi Sena NGO production environment template.
# Use placeholder values only in this file. Real values belong in Netlify or local .env.

# Frontend-safe variables. Set these in Netlify with Build scope.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_USE_GOOGLE_DRIVE_IMAGES=false

# Netlify Function variables. Set these in Netlify with Functions scope.
# SUPABASE_URL may match VITE_SUPABASE_URL.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Recommended for normal/personal Google Drive folders.
# Create these through Google Cloud OAuth and OAuth Playground.
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token

# Alternative for Google Workspace Shared Drive folders only.
# Leave OAuth variables empty if using service-account auth.
# GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# Optional upload controls.
# GOOGLE_DRIVE_MAX_UPLOAD_BYTES=8388608
# GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive
