VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_USE_GOOGLE_DRIVE_IMAGES=false

# Netlify Function secrets. Set these in Netlify, not in frontend code.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Option A: Google service account. Best for Google Workspace Shared Drives.
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=base64-encoded-service-account-json

# Option B: OAuth refresh token. Best for a personal Google My Drive folder.
# GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=your-google-oauth-client-secret
# GOOGLE_OAUTH_REFRESH_TOKEN=your-google-oauth-refresh-token

# Optional alternatives when you do not use GOOGLE_SERVICE_ACCOUNT_JSON_BASE64.
# GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_MAX_UPLOAD_BYTES=8388608
# GOOGLE_DRIVE_SCOPE=https://www.googleapis.com/auth/drive
